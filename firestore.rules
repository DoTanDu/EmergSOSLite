rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsResource() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsRequest() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /emergencyContacts/{contactId} {
      allow create: if ownsRequest();
      allow read, update, delete: if ownsResource();
    }

    match /sosEvents/{eventId} {
      allow create: if ownsRequest();
      allow read, update, delete: if ownsResource();
    }

    match /dangerReports/{reportId} {
      allow read: if signedIn();
      allow create: if ownsRequest();
      allow update, delete: if ownsResource();
    }

    match /recordingEvents/{recordingId} {
      allow create: if ownsRequest();
      allow read, update, delete: if ownsResource();
    }
  }
}
