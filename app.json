{
  "expo": {
    "name": "EmergSOS Lite",
    "slug": "emergsos-lite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "emergsoslite",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#E53935",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "EmergSOS Lite cần vị trí để tạo cảnh báo SOS kèm link Google Maps.",
        "NSPhotoLibraryUsageDescription": "EmergSOS Lite cần quyền thư viện ảnh để cập nhật ảnh đại diện."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E53935"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-audio",
      "expo-image-picker"
    ]
  }
}
